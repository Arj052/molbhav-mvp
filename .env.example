# Copy this file to .env and fill it in with the values printed by:  npm run setup-admin
# .env is ignored by git — never commit it or paste it anywhere public.

ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH='$2a$12$replace-with-the-hash-from-setup-admin'
ADMIN_PATH=/admin-replace-with-random-value
# Optional but recommended: 2-step codes from an authenticator app
ADMIN_TOTP_SECRET=

# Optional: "Continue with Google" button. Paste your OAuth Client ID (ends in .apps.googleusercontent.com).
# This value is public (Google shows it in the browser) — it is NOT a secret. Leave empty to hide the button.
GOOGLE_CLIENT_ID=

# Where the database file lives (use a persistent disk path on your host)
DB_PATH=./data/molbhav.db

PORT=3000
# Set to production on your host (turns on secure HTTPS-only cookies)
NODE_ENV=development
